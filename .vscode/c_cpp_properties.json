{
    "configurations": [
        {
            "name": "MSYS2 CLANG64",
            "compilerPath": "C:/msys64/clang64/bin/clang++.exe",
            "intelliSenseMode": "windows-clang-x64",
            "cppStandard": "c++17",
            "cStandard": "c17",
            "includePath": [
                "${workspaceFolder}/src",
                "${workspaceFolder}/src/incbin",
                "${workspaceFolder}/src/nnue",
                "${workspaceFolder}/src/syzygy"
            ],
            "defines": [
                "USE_PTHREADS",
                "IS_64BIT",
                "USE_SSE2",
                "ARCH=x86-64"
            ]
        }
    ],
    "version": 4
}
